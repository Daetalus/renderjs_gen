{
  "must_use_rsvp_queue": true,
  "must_not_use_then": true,
  "must_not_use_id_attr": true,
  "must_not_use_global_dom": true,
  "must_not_call_external_changestate": true,
  "must_not_use_global_vars": true,
  "must_return_promise_chains": true,
  "must_use_json_compatible_args": true,
  "dom_writes_only_in_onstatechange": true,
  "component_scope": "single_gadget",
  "event_naming": "normalized_snake_case",
  "field_groups_activated": [
    "layout_html",
    "state_logic",
    "event_binding",
    "error_boundary"
  ],
  "forbidden_patterns": [
    ".then(",
    "id=",
    "document.querySelector",
    "document.querySelectorAll",
    "document.getElementById",
    "document.body",
    "window.X =",
    "innerHTML =",
    "outerHTML =",
    "this.state =",
    "state = state ||",
    ".addEventListener(",
    "onclick =",
    "throw new Error("
  ],
  "canon_rules": [
    {
      "rule_id": "must_not_call_external_changestate",
      "title": "Only mutate state through gadget.changeState",
      "summary": "Do not call changeState on external gadgets or globals.",
      "severity": "blocking",
      "applies_to": [
        "state_logic",
        "spec.state"
      ],
      "official_api_names": [
        "changeState"
      ]
    },
    {
      "rule_id": "dom_writes_only_in_onstatechange",
      "title": "Keep DOM writes inside onStateChange",
      "summary": "RenderJS DOM mutation should happen in onStateChange.",
      "severity": "blocking",
      "applies_to": [
        "ui_areas",
        "layout_html",
        "state_logic",
        "spec.state"
      ],
      "official_api_names": [
        "onStateChange"
      ]
    }
  ],
